{
  "name": "blossom-client-sdk",
  "version": "5.2.0",
  "description": "Client SDK for talking to blossom servers",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "typings": "./lib/index.d.ts",
  "author": "hzrd149",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublish": "npm run build",
    "test": "vitest run",
    "test:browser": "vitest run --browser --browser.headless",
    "test:node": "pnpm build && node node_modules/vitest/vitest.mjs run && node --test tests/package-exports.test.mjs tests/runtime/*.test.mjs",
    "test:deno": "pnpm build && deno run -A --no-config --no-lock --node-modules-dir=manual node_modules/vitest/vitest.mjs run && deno test -A --no-config --no-lock --no-check --node-modules-dir=manual tests/package-exports.test.mjs tests/runtime/",
    "test:bun": "pnpm build && bun run --bun node_modules/vitest/vitest.mjs run && bun test tests/package-exports.test.mjs tests/runtime/",
    "test:all": "pnpm test:node && pnpm test:deno && pnpm test:bun && pnpm test:browser",
    "coverage": "vitest run --coverage",
    "format": "prettier -w .",
    "docs": "typedoc src/index.ts"
  },
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./media": {
      "import": "./lib/media.js",
      "types": "./lib/media.d.ts"
    },
    "./hls": {
      "import": "./lib/hls.js",
      "types": "./lib/hls.d.ts"
    },
    "./helpers": {
      "import": "./lib/helpers/index.js",
      "types": "./lib/helpers/index.d.ts"
    },
    "./helpers/*": {
      "import": "./lib/helpers/*.js",
      "types": "./lib/helpers/*.d.ts"
    },
    "./nostr": {
      "import": "./lib/nostr.js",
      "types": "./lib/nostr.d.ts"
    },
    "./auth": {
      "import": "./lib/auth.js",
      "types": "./lib/auth.d.ts"
    },
    "./actions": {
      "import": "./lib/actions/index.js",
      "types": "./lib/actions/index.d.ts"
    },
    "./actions/*": {
      "import": "./lib/actions/*.js",
      "types": "./lib/actions/*.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "peerDependencies": {
    "hls.js": "^1.6.16"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cashu/cashu-ts": "^2.9.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "hls.js": "^1.7.4",
    "nostr-tools": "^2.26.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typedoc": "^0.25.13",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vitest-fetch-mock": "^0.4.5"
  },
  "packageManager": "pnpm@12.21.0"
}
