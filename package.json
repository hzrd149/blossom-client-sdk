{
  "name": "blossom-client-sdk",
  "version": "5.2.1",
  "description": "Client SDK for talking to blossom servers",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "typings": "./lib/index.d.ts",
  "author": "hzrd149",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublish": "pnpm run build",
    "publish:jsr:check": "node scripts/check-jsr.mjs && pnpm dlx jsr publish --dry-run --allow-dirty",
    "publish:jsr": "node scripts/check-jsr.mjs && pnpm dlx jsr publish",
    "test": "vitest run",
    "test:browser": "vitest run --browser --browser.headless",
    "test:node": "pnpm run build && node node_modules/vitest/vitest.mjs run && node --test tests/package-exports.test.mjs tests/runtime/*.test.mjs",
    "test:deno": "pnpm run build && deno run -A --no-config --no-lock --node-modules-dir=manual node_modules/vitest/vitest.mjs run && deno test -A --no-config --no-lock --no-check --node-modules-dir=manual tests/package-exports.test.mjs tests/runtime/",
    "test:bun": "pnpm run build && bun run --bun node_modules/vitest/vitest.mjs run && bun test tests/package-exports.test.mjs tests/runtime/",
    "test:all": "pnpm run \"/^test:(node|deno|bun|browser)$/\"",
    "coverage": "vitest run --coverage",
    "format": "prettier -w ."
  },
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./media": {
      "import": "./lib/media.js",
      "types": "./lib/media.d.ts"
    },
    "./hls": {
      "import": "./lib/hls.js",
      "types": "./lib/hls.d.ts"
    },
    "./helpers": {
      "import": "./lib/helpers/index.js",
      "types": "./lib/helpers/index.d.ts"
    },
    "./helpers/*": {
      "import": "./lib/helpers/*.js",
      "types": "./lib/helpers/*.d.ts"
    },
    "./nostr": {
      "import": "./lib/nostr.js",
      "types": "./lib/nostr.d.ts"
    },
    "./auth": {
      "import": "./lib/auth.js",
      "types": "./lib/auth.d.ts"
    },
    "./actions": {
      "import": "./lib/actions/index.js",
      "types": "./lib/actions/index.d.ts"
    },
    "./actions/*": {
      "import": "./lib/actions/*.js",
      "types": "./lib/actions/*.d.ts"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "peerDependencies": {
    "hls.js": "^1.6.16"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cashu/cashu-ts": "^4.13.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "hls.js": "^1.7.4",
    "nostr-tools": "^2.26.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "vitest-fetch-mock": "^0.4.5"
  },
  "packageManager": "pnpm@12.23.0"
}
